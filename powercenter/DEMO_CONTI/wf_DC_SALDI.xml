<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  Motore      : DEMO_CONTI
  Workflow    : wf_DC_SALDI
  Descrizione : Export PowerCenter SEMPLIFICATO e INVENTATO a scopo dimostrativo.
                Contiene solo i campi principali; non e' importabile in un
                repository reale.
-->
<POWERMART CREATION_DATE="09/30/2026 09:30:00" REPOSITORY_VERSION="189.99">
<REPOSITORY NAME="REP_DEMO" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="DEMO_CONTI" GROUP="" OWNER="demo_owner" SHARED="NOTSHARED" DESCRIPTION="Motore DEMO_CONTI (dimostrativo)" PERMISSIONS="rwx---r--" UUID="00000000-0000-0000-0000-000000000002">

    <!-- ===================== SORGENTE ===================== -->
    <SOURCE NAME="DC_FT_MOVIMENTI" DBDNAME="DEMO_DWH" DATABASETYPE="Oracle" OWNERNAME="DEMO_DWH" DESCRIPTION="Movimenti con causale e segno">
        <SOURCEFIELD NAME="COD_ISTITUTO"  DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="DAT_CONTABILE" DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_CONTO"     DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_SEGNO"     DATATYPE="char"     PRECISION="1"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="IMP_MOVIMENTO" DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="IMP_CON_SEGNO" DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </SOURCE>

    <!-- ===================== TARGET ===================== -->
    <TARGET NAME="DC_FT_SALDI_MENSILI" DATABASETYPE="Oracle" DESCRIPTION="Saldi mensili per conto">
        <TARGETFIELD NAME="COD_ISTITUTO"       DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_RIFERIMENTO"    DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_CONTO"          DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_SALDO_INIZIALE" DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_ENTRATE"        DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_USCITE"         DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_SALDO_FINALE"   DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_ELABORAZIONE"    DATATYPE="number"   PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </TARGET>

    <!-- ===================== MAPPING ===================== -->
    <MAPPING NAME="m_DC_SALDI" ISVALID="YES" DESCRIPTION="Calcola per ogni conto saldo iniziale, entrate, uscite e saldo finale del mese">

        <!-- Saldo iniziale e finale sono somme dei movimenti fino alla propria data (data contabile, non valuta) -->
        <TRANSFORMATION NAME="SQ_DC_FT_MOVIMENTI" TYPE="Source Qualifier" REUSABLE="NO">
            <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT m.COD_ISTITUTO, m.COD_CONTO, SUM(CASE WHEN m.DAT_CONTABILE &lt; TRUNC(TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD'), 'MM') THEN m.IMP_CON_SEGNO ELSE 0 END) AS IMP_SALDO_INIZIALE, SUM(CASE WHEN m.DAT_CONTABILE &gt;= TRUNC(TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD'), 'MM') AND m.COD_SEGNO = '+' THEN m.IMP_MOVIMENTO ELSE 0 END) AS IMP_ENTRATE, SUM(CASE WHEN m.DAT_CONTABILE &gt;= TRUNC(TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD'), 'MM') AND m.COD_SEGNO = '-' THEN m.IMP_MOVIMENTO ELSE 0 END) AS IMP_USCITE, SUM(m.IMP_CON_SEGNO) AS IMP_SALDO_FINALE FROM DEMO_DWH.DC_FT_MOVIMENTI m WHERE m.COD_ISTITUTO = '$$COD_ISTITUTO' AND m.DAT_CONTABILE &lt;= TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD') GROUP BY m.COD_ISTITUTO, m.COD_CONTO"/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="EXP_SALDI" TYPE="Expression" REUSABLE="NO">
            <TRANSFORMFIELD NAME="O_DAT_RIFERIMENTO" DATATYPE="date/time" PRECISION="29" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DATE('$$DAT_RIFERIMENTO', 'YYYYMMDD')"/>
            <TRANSFORMFIELD NAME="O_ID_ELABORAZIONE" DATATYPE="decimal" PRECISION="12" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL($$ID_ELABORAZIONE)"/>
        </TRANSFORMATION>

        <INSTANCE NAME="DC_FT_MOVIMENTI"    TYPE="SOURCE"         TRANSFORMATION_NAME="DC_FT_MOVIMENTI"/>
        <INSTANCE NAME="SQ_DC_FT_MOVIMENTI" TYPE="TRANSFORMATION" TRANSFORMATION_NAME="SQ_DC_FT_MOVIMENTI"/>
        <INSTANCE NAME="EXP_SALDI"          TYPE="TRANSFORMATION" TRANSFORMATION_NAME="EXP_SALDI"/>
        <INSTANCE NAME="DC_FT_SALDI_MENSILI" TYPE="TARGET"        TRANSFORMATION_NAME="DC_FT_SALDI_MENSILI"/>

        <!-- Collegamenti principali (elenco ridotto) -->
        <CONNECTOR FROMINSTANCE="SQ_DC_FT_MOVIMENTI" FROMFIELD="COD_ISTITUTO"       TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="COD_ISTITUTO"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_FT_MOVIMENTI" FROMFIELD="COD_CONTO"          TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="COD_CONTO"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_FT_MOVIMENTI" FROMFIELD="IMP_SALDO_INIZIALE" TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="IMP_SALDO_INIZIALE"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_FT_MOVIMENTI" FROMFIELD="IMP_ENTRATE"        TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="IMP_ENTRATE"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_FT_MOVIMENTI" FROMFIELD="IMP_USCITE"         TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="IMP_USCITE"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_FT_MOVIMENTI" FROMFIELD="IMP_SALDO_FINALE"   TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="IMP_SALDO_FINALE"/>
        <CONNECTOR FROMINSTANCE="EXP_SALDI" FROMFIELD="O_DAT_RIFERIMENTO" TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="DAT_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="EXP_SALDI" FROMFIELD="O_ID_ELABORAZIONE" TOINSTANCE="DC_FT_SALDI_MENSILI" TOFIELD="ID_ELABORAZIONE"/>

        <MAPPINGVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" PRECISION="5"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" PRECISION="8"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" PRECISION="12" ISPARAM="YES" DEFAULTVALUE=""/>
    </MAPPING>

    <!-- ===================== SESSIONE ===================== -->
    <SESSION NAME="s_m_DC_SALDI" MAPPINGNAME="m_DC_SALDI" REUSABLE="NO" DESCRIPTION="Calcolo dei saldi mensili per istituto e mese">
        <SESSIONEXTENSION SINSTANCENAME="DC_FT_SALDI_MENSILI" TYPE="WRITER">
            <CONNECTIONREFERENCE CONNECTIONNAME="CNX_DEMO_DWH" CONNECTIONTYPE="Relational"/>
            <ATTRIBUTE NAME="Truncate target table option" VALUE="NO"/>
        </SESSIONEXTENSION>
        <ATTRIBUTE NAME="Pushdown Optimization" VALUE="None"/>
    </SESSION>

    <!-- ===================== WORKFLOW ===================== -->
    <WORKFLOW NAME="wf_DC_SALDI" ISVALID="YES" SERVERNAME="IS_DEMO" DESCRIPTION="DEMO_CONTI - saldi mensili, lanciato da lancia_dc_saldi.sh">
        <TASK NAME="Start" TYPE="Start"/>
        <TASKINSTANCE NAME="Start"        TASKNAME="Start"        TASKTYPE="Start"/>
        <TASKINSTANCE NAME="s_m_DC_SALDI" TASKNAME="s_m_DC_SALDI" TASKTYPE="Session" FAIL_PARENT_IF_INSTANCE_FAILS="YES"/>
        <WORKFLOWLINK FROMTASK="Start" TOTASK="s_m_DC_SALDI" CONDITION=""/>
        <WORKFLOWVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Istituto in lavorazione, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Ultimo giorno del mese YYYYMMDD, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Elaborazione aperta dalla shell in DC_LOG_ELABORAZIONI"/>
    </WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
