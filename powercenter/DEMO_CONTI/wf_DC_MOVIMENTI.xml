<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  Motore      : DEMO_CONTI
  Workflow    : wf_DC_MOVIMENTI
  Descrizione : Export PowerCenter SEMPLIFICATO e INVENTATO a scopo dimostrativo.
                Contiene solo i campi principali; non e' importabile in un
                repository reale.
-->
<POWERMART CREATION_DATE="09/30/2026 09:20:00" REPOSITORY_VERSION="189.99">
<REPOSITORY NAME="REP_DEMO" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="DEMO_CONTI" GROUP="" OWNER="demo_owner" SHARED="NOTSHARED" DESCRIPTION="Motore DEMO_CONTI (dimostrativo)" PERMISSIONS="rwx---r--" UUID="00000000-0000-0000-0000-000000000002">

    <!-- ===================== SORGENTE ===================== -->
    <SOURCE NAME="DC_STG_MOVIMENTI" DBDNAME="DEMO_DWH" DATABASETYPE="Oracle" OWNERNAME="DEMO_DWH" DESCRIPTION="Staging dei movimenti">
        <SOURCEFIELD NAME="COD_ISTITUTO"    DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="DAT_RIFERIMENTO" DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="ID_MOVIMENTO"    DATATYPE="varchar2" PRECISION="30" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_CONTO"       DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_CAUSALE"     DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="DAT_CONTABILE"   DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="DAT_VALUTA"      DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="IMP_MOVIMENTO"   DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </SOURCE>

    <!-- ===================== TARGET ===================== -->
    <TARGET NAME="DC_FT_MOVIMENTI" DATABASETYPE="Oracle" DESCRIPTION="Movimenti con causale e segno">
        <TARGETFIELD NAME="COD_ISTITUTO"    DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_CONTABILE"   DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_MOVIMENTO"    DATATYPE="varchar2" PRECISION="30" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_CONTO"       DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_CAUSALE"     DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_SEGNO"       DATATYPE="char"     PRECISION="1"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_MOVIMENTO"   DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_CON_SEGNO"   DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_VALUTA"      DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_ELABORAZIONE" DATATYPE="number"   PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </TARGET>

    <!-- ===================== MAPPING ===================== -->
    <MAPPING NAME="m_DC_MOVIMENTI" ISVALID="YES" DESCRIPTION="Toglie i doppioni, assegna causale e segno e calcola l importo con segno">

        <!-- Il file puo contenere lo stesso movimento piu volte: si tiene una sola riga per ID_MOVIMENTO -->
        <TRANSFORMATION NAME="SQ_DC_STG_MOVIMENTI" TYPE="Source Qualifier" REUSABLE="NO">
            <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT s.COD_ISTITUTO, s.ID_MOVIMENTO, s.COD_CONTO, s.COD_CAUSALE, s.DAT_CONTABILE, s.DAT_VALUTA, s.IMP_MOVIMENTO FROM (SELECT t.COD_ISTITUTO, t.ID_MOVIMENTO, t.COD_CONTO, t.COD_CAUSALE, t.DAT_CONTABILE, t.DAT_VALUTA, t.IMP_MOVIMENTO, ROW_NUMBER() OVER (PARTITION BY t.ID_MOVIMENTO ORDER BY t.DAT_CARICAMENTO) AS NUM_RIGA FROM DEMO_DWH.DC_STG_MOVIMENTI t WHERE t.COD_ISTITUTO = '$$COD_ISTITUTO' AND t.DAT_RIFERIMENTO = TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD')) s WHERE s.NUM_RIGA = 1"/>
        </TRANSFORMATION>

        <!-- Causale e segno: la lookup legge la versione valida alla data di riferimento -->
        <TRANSFORMATION NAME="LKP_DC_DIM_CAUSALE" TYPE="Lookup Procedure" REUSABLE="NO">
            <TRANSFORMFIELD NAME="IN_COD_CAUSALE" DATATYPE="string" PRECISION="20" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="COD_CAUSALE"    DATATYPE="string" PRECISION="20" PORTTYPE="LOOKUP"/>
            <TRANSFORMFIELD NAME="COD_SEGNO"      DATATYPE="string" PRECISION="1"  PORTTYPE="LOOKUP/OUTPUT"/>
            <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DEMO_DWH.DC_DIM_CAUSALE"/>
            <TABLEATTRIBUTE NAME="Lookup Sql Override" VALUE="SELECT COD_CAUSALE, COD_SEGNO FROM DEMO_DWH.DC_DIM_CAUSALE WHERE TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD') BETWEEN DAT_INIZIO_VALIDITA AND DAT_FINE_VALIDITA"/>
            <TABLEATTRIBUTE NAME="Lookup condition" VALUE="COD_CAUSALE = IN_COD_CAUSALE"/>
        </TRANSFORMATION>

        <!-- Segno e importo con segno: + entra, - esce -->
        <TRANSFORMATION NAME="EXP_SEGNO" TYPE="Expression" REUSABLE="NO">
            <TRANSFORMFIELD NAME="IMP_MOVIMENTO" DATATYPE="decimal" PRECISION="18" SCALE="2" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="COD_SEGNO"     DATATYPE="string"  PRECISION="1"  PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="O_IMP_CON_SEGNO" DATATYPE="decimal" PRECISION="18" SCALE="2" PORTTYPE="OUTPUT"
                EXPRESSION="IIF(COD_SEGNO = '-', -IMP_MOVIMENTO, IMP_MOVIMENTO)"/>
            <TRANSFORMFIELD NAME="O_ID_ELABORAZIONE" DATATYPE="decimal" PRECISION="12" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL($$ID_ELABORAZIONE)"/>
        </TRANSFORMATION>

        <!-- Una causale sconosciuta non viene caricata: la quadratura con lo staging va in KO -->
        <TRANSFORMATION NAME="FIL_CAUSALE_NOTA" TYPE="Filter" REUSABLE="NO">
            <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT ISNULL(COD_SEGNO)"/>
        </TRANSFORMATION>

        <INSTANCE NAME="DC_STG_MOVIMENTI"    TYPE="SOURCE"         TRANSFORMATION_NAME="DC_STG_MOVIMENTI"/>
        <INSTANCE NAME="SQ_DC_STG_MOVIMENTI" TYPE="TRANSFORMATION" TRANSFORMATION_NAME="SQ_DC_STG_MOVIMENTI"/>
        <INSTANCE NAME="LKP_DC_DIM_CAUSALE"  TYPE="TRANSFORMATION" TRANSFORMATION_NAME="LKP_DC_DIM_CAUSALE"/>
        <INSTANCE NAME="EXP_SEGNO"           TYPE="TRANSFORMATION" TRANSFORMATION_NAME="EXP_SEGNO"/>
        <INSTANCE NAME="FIL_CAUSALE_NOTA"    TYPE="TRANSFORMATION" TRANSFORMATION_NAME="FIL_CAUSALE_NOTA"/>
        <INSTANCE NAME="DC_FT_MOVIMENTI"     TYPE="TARGET"         TRANSFORMATION_NAME="DC_FT_MOVIMENTI"/>

        <!-- Collegamenti principali (elenco ridotto) -->
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="COD_CAUSALE"   TOINSTANCE="LKP_DC_DIM_CAUSALE" TOFIELD="IN_COD_CAUSALE"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="IMP_MOVIMENTO" TOINSTANCE="EXP_SEGNO"          TOFIELD="IMP_MOVIMENTO"/>
        <CONNECTOR FROMINSTANCE="LKP_DC_DIM_CAUSALE"  FROMFIELD="COD_SEGNO"     TOINSTANCE="EXP_SEGNO"          TOFIELD="COD_SEGNO"/>
        <CONNECTOR FROMINSTANCE="LKP_DC_DIM_CAUSALE"  FROMFIELD="COD_SEGNO"     TOINSTANCE="FIL_CAUSALE_NOTA"   TOFIELD="COD_SEGNO"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="ID_MOVIMENTO"  TOINSTANCE="DC_FT_MOVIMENTI"    TOFIELD="ID_MOVIMENTO"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="COD_CONTO"     TOINSTANCE="DC_FT_MOVIMENTI"    TOFIELD="COD_CONTO"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="COD_CAUSALE"   TOINSTANCE="DC_FT_MOVIMENTI"    TOFIELD="COD_CAUSALE"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="DAT_CONTABILE" TOINSTANCE="DC_FT_MOVIMENTI"    TOFIELD="DAT_CONTABILE"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="DAT_VALUTA"    TOINSTANCE="DC_FT_MOVIMENTI"    TOFIELD="DAT_VALUTA"/>
        <CONNECTOR FROMINSTANCE="SQ_DC_STG_MOVIMENTI" FROMFIELD="IMP_MOVIMENTO" TOINSTANCE="DC_FT_MOVIMENTI"    TOFIELD="IMP_MOVIMENTO"/>
        <CONNECTOR FROMINSTANCE="FIL_CAUSALE_NOTA"    FROMFIELD="COD_SEGNO"     TOINSTANCE="DC_FT_MOVIMENTI"    TOFIELD="COD_SEGNO"/>
        <CONNECTOR FROMINSTANCE="EXP_SEGNO" FROMFIELD="O_IMP_CON_SEGNO"   TOINSTANCE="DC_FT_MOVIMENTI" TOFIELD="IMP_CON_SEGNO"/>
        <CONNECTOR FROMINSTANCE="EXP_SEGNO" FROMFIELD="O_ID_ELABORAZIONE" TOINSTANCE="DC_FT_MOVIMENTI" TOFIELD="ID_ELABORAZIONE"/>

        <MAPPINGVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" PRECISION="5"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" PRECISION="8"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" PRECISION="12" ISPARAM="YES" DEFAULTVALUE=""/>
    </MAPPING>

    <!-- ===================== SESSIONE ===================== -->
    <SESSION NAME="s_m_DC_MOVIMENTI" MAPPINGNAME="m_DC_MOVIMENTI" REUSABLE="NO" DESCRIPTION="Carico dei movimenti per istituto e giorno">
        <SESSIONEXTENSION SINSTANCENAME="DC_FT_MOVIMENTI" TYPE="WRITER">
            <CONNECTIONREFERENCE CONNECTIONNAME="CNX_DEMO_DWH" CONNECTIONTYPE="Relational"/>
            <ATTRIBUTE NAME="Truncate target table option" VALUE="NO"/>
        </SESSIONEXTENSION>
        <ATTRIBUTE NAME="Pushdown Optimization" VALUE="None"/>
    </SESSION>

    <!-- ===================== WORKFLOW ===================== -->
    <WORKFLOW NAME="wf_DC_MOVIMENTI" ISVALID="YES" SERVERNAME="IS_DEMO" DESCRIPTION="DEMO_CONTI - flusso dei movimenti, lanciato da lancia_dc_movimenti.sh">
        <TASK NAME="Start" TYPE="Start"/>
        <TASKINSTANCE NAME="Start"            TASKNAME="Start"            TASKTYPE="Start"/>
        <TASKINSTANCE NAME="s_m_DC_MOVIMENTI" TASKNAME="s_m_DC_MOVIMENTI" TASKTYPE="Session" FAIL_PARENT_IF_INSTANCE_FAILS="YES"/>
        <WORKFLOWLINK FROMTASK="Start" TOTASK="s_m_DC_MOVIMENTI" CONDITION=""/>
        <WORKFLOWVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Istituto in lavorazione, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Data di riferimento YYYYMMDD, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Elaborazione aperta dalla shell in DC_LOG_ELABORAZIONI"/>
    </WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
