<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  Motore      : DEMO_CONTI
  Workflow    : wf_DC_CARICO_MOVIMENTI
  Descrizione : Export PowerCenter SEMPLIFICATO e INVENTATO a scopo dimostrativo.
                Contiene solo i campi principali; non e' importabile in un
                repository reale.
-->
<POWERMART CREATION_DATE="09/30/2026 09:10:00" REPOSITORY_VERSION="189.99">
<REPOSITORY NAME="REP_DEMO" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="DEMO_CONTI" GROUP="" OWNER="demo_owner" SHARED="NOTSHARED" DESCRIPTION="Motore DEMO_CONTI (dimostrativo)" PERMISSIONS="rwx---r--" UUID="00000000-0000-0000-0000-000000000002">

    <!-- ===================== SORGENTE (file) ===================== -->
    <SOURCE NAME="FF_MOVIMENTI_FONTE_A" DBDNAME="FlatFile" DATABASETYPE="Flat File" DESCRIPTION="File giornaliero dei movimenti di FONTE_A, uno per banca">
        <FLATFILE DELIMITED="YES" DELIMITERS=";" SKIPROWS="1" CODEPAGE="UTF-8" NULLCHARTYPE="ASCII" PADBYTES="1"/>
        <SOURCEFIELD NAME="COD_ISTITUTO"     DATATYPE="string" PRECISION="5"  SCALE="0"/>
        <SOURCEFIELD NAME="DATA_RIFERIMENTO" DATATYPE="string" PRECISION="8"  SCALE="0"/>
        <SOURCEFIELD NAME="ID_MOVIMENTO"     DATATYPE="string" PRECISION="30" SCALE="0"/>
        <SOURCEFIELD NAME="COD_CONTO"        DATATYPE="string" PRECISION="20" SCALE="0"/>
        <SOURCEFIELD NAME="COD_CAUSALE"      DATATYPE="string" PRECISION="20" SCALE="0"/>
        <SOURCEFIELD NAME="DATA_CONTABILE"   DATATYPE="string" PRECISION="8"  SCALE="0"/>
        <SOURCEFIELD NAME="DATA_VALUTA"      DATATYPE="string" PRECISION="8"  SCALE="0"/>
        <SOURCEFIELD NAME="IMP_MOVIMENTO"    DATATYPE="string" PRECISION="20" SCALE="0"/>
    </SOURCE>

    <!-- ===================== TARGET ===================== -->
    <TARGET NAME="DC_STG_MOVIMENTI" DATABASETYPE="Oracle" DESCRIPTION="Staging dei movimenti">
        <TARGETFIELD NAME="COD_ISTITUTO"      DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_RIFERIMENTO"   DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_MOVIMENTO"      DATATYPE="varchar2" PRECISION="30" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_CONTO"         DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_CAUSALE"       DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_CONTABILE"     DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_VALUTA"        DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_MOVIMENTO"     DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_SISTEMA_FONTE" DATATYPE="varchar2" PRECISION="10" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_ELABORAZIONE"   DATATYPE="number"   PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </TARGET>

    <!-- ===================== MAPPING ===================== -->
    <MAPPING NAME="m_DC_CARICO_MOVIMENTI" ISVALID="YES" DESCRIPTION="Carica il file di FONTE_A nello staging, convertendo date e importi">

        <TRANSFORMATION NAME="SQ_FF_MOVIMENTI_FONTE_A" TYPE="Source Qualifier" REUSABLE="NO"/>

        <!-- Conversioni: date YYYYMMDD, importi con la virgola decimale -->
        <TRANSFORMATION NAME="EXP_CONVERTI" TYPE="Expression" REUSABLE="NO">
            <TRANSFORMFIELD NAME="DATA_RIFERIMENTO" DATATYPE="string" PRECISION="8"  PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="DATA_CONTABILE"   DATATYPE="string" PRECISION="8"  PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="DATA_VALUTA"      DATATYPE="string" PRECISION="8"  PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="IMP_MOVIMENTO"    DATATYPE="string" PRECISION="20" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="O_DAT_RIFERIMENTO" DATATYPE="date/time" PRECISION="29" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DATE(DATA_RIFERIMENTO, 'YYYYMMDD')"/>
            <TRANSFORMFIELD NAME="O_DAT_CONTABILE"   DATATYPE="date/time" PRECISION="29" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DATE(DATA_CONTABILE, 'YYYYMMDD')"/>
            <TRANSFORMFIELD NAME="O_DAT_VALUTA"      DATATYPE="date/time" PRECISION="29" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DATE(DATA_VALUTA, 'YYYYMMDD')"/>
            <TRANSFORMFIELD NAME="O_IMP_MOVIMENTO"   DATATYPE="decimal" PRECISION="18" SCALE="2" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL(REPLACESTR(0, IMP_MOVIMENTO, ',', '.'), 2)"/>
            <TRANSFORMFIELD NAME="O_COD_SISTEMA_FONTE" DATATYPE="string" PRECISION="10" PORTTYPE="OUTPUT"
                EXPRESSION="'FONTE_A'"/>
            <TRANSFORMFIELD NAME="O_ID_ELABORAZIONE" DATATYPE="decimal" PRECISION="12" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL($$ID_ELABORAZIONE)"/>
        </TRANSFORMATION>

        <!-- Scarta le righe di altre banche o di altri giorni e quelle senza importo -->
        <TRANSFORMATION NAME="FIL_RIGHE_VALIDE" TYPE="Filter" REUSABLE="NO">
            <TABLEATTRIBUTE NAME="Filter Condition" VALUE="COD_ISTITUTO = '$$COD_ISTITUTO' AND DATA_RIFERIMENTO = '$$DAT_RIFERIMENTO' AND NOT ISNULL(O_IMP_MOVIMENTO)"/>
        </TRANSFORMATION>

        <INSTANCE NAME="FF_MOVIMENTI_FONTE_A"    TYPE="SOURCE"         TRANSFORMATION_NAME="FF_MOVIMENTI_FONTE_A"/>
        <INSTANCE NAME="SQ_FF_MOVIMENTI_FONTE_A" TYPE="TRANSFORMATION" TRANSFORMATION_NAME="SQ_FF_MOVIMENTI_FONTE_A"/>
        <INSTANCE NAME="EXP_CONVERTI"            TYPE="TRANSFORMATION" TRANSFORMATION_NAME="EXP_CONVERTI"/>
        <INSTANCE NAME="FIL_RIGHE_VALIDE"        TYPE="TRANSFORMATION" TRANSFORMATION_NAME="FIL_RIGHE_VALIDE"/>
        <INSTANCE NAME="DC_STG_MOVIMENTI"        TYPE="TARGET"         TRANSFORMATION_NAME="DC_STG_MOVIMENTI"/>

        <!-- Collegamenti principali (elenco ridotto) -->
        <CONNECTOR FROMINSTANCE="SQ_FF_MOVIMENTI_FONTE_A" FROMFIELD="DATA_RIFERIMENTO" TOINSTANCE="EXP_CONVERTI" TOFIELD="DATA_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="SQ_FF_MOVIMENTI_FONTE_A" FROMFIELD="DATA_CONTABILE"   TOINSTANCE="EXP_CONVERTI" TOFIELD="DATA_CONTABILE"/>
        <CONNECTOR FROMINSTANCE="SQ_FF_MOVIMENTI_FONTE_A" FROMFIELD="DATA_VALUTA"      TOINSTANCE="EXP_CONVERTI" TOFIELD="DATA_VALUTA"/>
        <CONNECTOR FROMINSTANCE="SQ_FF_MOVIMENTI_FONTE_A" FROMFIELD="IMP_MOVIMENTO"    TOINSTANCE="EXP_CONVERTI" TOFIELD="IMP_MOVIMENTO"/>
        <CONNECTOR FROMINSTANCE="EXP_CONVERTI"     FROMFIELD="O_DAT_RIFERIMENTO"   TOINSTANCE="FIL_RIGHE_VALIDE"  TOFIELD="O_DAT_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="EXP_CONVERTI"     FROMFIELD="O_IMP_MOVIMENTO"     TOINSTANCE="FIL_RIGHE_VALIDE"  TOFIELD="O_IMP_MOVIMENTO"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_DAT_RIFERIMENTO"   TOINSTANCE="DC_STG_MOVIMENTI"    TOFIELD="DAT_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_DAT_CONTABILE"     TOINSTANCE="DC_STG_MOVIMENTI"    TOFIELD="DAT_CONTABILE"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_DAT_VALUTA"        TOINSTANCE="DC_STG_MOVIMENTI"    TOFIELD="DAT_VALUTA"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_IMP_MOVIMENTO"     TOINSTANCE="DC_STG_MOVIMENTI"    TOFIELD="IMP_MOVIMENTO"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_COD_SISTEMA_FONTE" TOINSTANCE="DC_STG_MOVIMENTI"    TOFIELD="COD_SISTEMA_FONTE"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_ID_ELABORAZIONE"   TOINSTANCE="DC_STG_MOVIMENTI"    TOFIELD="ID_ELABORAZIONE"/>

        <MAPPINGVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" PRECISION="5"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" PRECISION="8"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" PRECISION="12" ISPARAM="YES" DEFAULTVALUE=""/>
    </MAPPING>

    <!-- ===================== SESSIONE ===================== -->
    <SESSION NAME="s_m_DC_CARICO_MOVIMENTI" MAPPINGNAME="m_DC_CARICO_MOVIMENTI" REUSABLE="NO" DESCRIPTION="Carico del file di una banca nello staging">
        <SESSIONEXTENSION SINSTANCENAME="SQ_FF_MOVIMENTI_FONTE_A" TYPE="READER">
            <ATTRIBUTE NAME="Source filetype" VALUE="Direct"/>
            <ATTRIBUTE NAME="Source file name" VALUE="$InputFile_Movimenti"/>
        </SESSIONEXTENSION>
        <SESSIONEXTENSION SINSTANCENAME="DC_STG_MOVIMENTI" TYPE="WRITER">
            <CONNECTIONREFERENCE CONNECTIONNAME="CNX_DEMO_DWH" CONNECTIONTYPE="Relational"/>
            <ATTRIBUTE NAME="Truncate target table option" VALUE="NO"/>
            <!-- Normalizza le causali arrivate con spazi o in minuscolo, prima del flusso dei movimenti -->
            <ATTRIBUTE NAME="Post SQL" VALUE="UPDATE DEMO_DWH.DC_STG_MOVIMENTI SET COD_CAUSALE = UPPER(TRIM(COD_CAUSALE)) WHERE COD_ISTITUTO = '$$COD_ISTITUTO'"/>
        </SESSIONEXTENSION>
        <ATTRIBUTE NAME="Pushdown Optimization" VALUE="None"/>
    </SESSION>

    <!-- ===================== WORKFLOW ===================== -->
    <WORKFLOW NAME="wf_DC_CARICO_MOVIMENTI" ISVALID="YES" SERVERNAME="IS_DEMO" DESCRIPTION="DEMO_CONTI - carico dello staging, lanciato da lancia_dc_carico_movimenti.sh">
        <TASK NAME="Start" TYPE="Start"/>
        <TASKINSTANCE NAME="Start"                   TASKNAME="Start"                   TASKTYPE="Start"/>
        <TASKINSTANCE NAME="s_m_DC_CARICO_MOVIMENTI" TASKNAME="s_m_DC_CARICO_MOVIMENTI" TASKTYPE="Session" FAIL_PARENT_IF_INSTANCE_FAILS="YES"/>
        <WORKFLOWLINK FROMTASK="Start" TOTASK="s_m_DC_CARICO_MOVIMENTI" CONDITION=""/>
        <WORKFLOWVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Istituto in lavorazione, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Data di riferimento YYYYMMDD, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Elaborazione aperta dalla shell in DC_LOG_ELABORAZIONI"/>
    </WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
