<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  Motore      : DEMO_INVESTIMENTI
  Workflow    : wf_DI_CARICO_ORDINI
  Descrizione : Export PowerCenter SEMPLIFICATO e INVENTATO a scopo dimostrativo.
                Contiene solo i campi principali; non e' importabile in un
                repository reale.
-->
<POWERMART CREATION_DATE="09/30/2026 14:20:00" REPOSITORY_VERSION="189.99">
<REPOSITORY NAME="REP_DEMO" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="DEMO_INVESTIMENTI" GROUP="" OWNER="demo_owner" SHARED="NOTSHARED" DESCRIPTION="Motore DEMO_INVESTIMENTI (dimostrativo)" PERMISSIONS="rwx---r--" UUID="00000000-0000-0000-0000-000000000003">

    <!-- ===================== SORGENTE (file) ===================== -->
    <SOURCE NAME="FF_ORDINI_FONTE_B" DBDNAME="FlatFile" DATABASETYPE="Flat File" DESCRIPTION="File giornaliero degli ordini eseguiti di FONTE_B, uno per banca">
        <FLATFILE DELIMITED="YES" DELIMITERS=";" SKIPROWS="1" CODEPAGE="UTF-8" NULLCHARTYPE="ASCII" PADBYTES="1"/>
        <SOURCEFIELD NAME="COD_ISTITUTO"       DATATYPE="string" PRECISION="5"  SCALE="0"/>
        <SOURCEFIELD NAME="DATA_RIFERIMENTO"   DATATYPE="string" PRECISION="8"  SCALE="0"/>
        <SOURCEFIELD NAME="ID_ORDINE"          DATATYPE="string" PRECISION="30" SCALE="0"/>
        <SOURCEFIELD NAME="COD_DOSSIER"        DATATYPE="string" PRECISION="20" SCALE="0"/>
        <SOURCEFIELD NAME="COD_TITOLO"         DATATYPE="string" PRECISION="12" SCALE="0"/>
        <SOURCEFIELD NAME="COD_OPERAZIONE"     DATATYPE="string" PRECISION="10" SCALE="0"/>
        <SOURCEFIELD NAME="QTA_ORDINE"         DATATYPE="string" PRECISION="20" SCALE="0"/>
        <SOURCEFIELD NAME="IMP_PREZZO"         DATATYPE="string" PRECISION="20" SCALE="0"/>
        <SOURCEFIELD NAME="COD_CONTO_ADDEBITO" DATATYPE="string" PRECISION="20" SCALE="0"/>
    </SOURCE>

    <!-- ===================== TARGET ===================== -->
    <TARGET NAME="DI_STG_ORDINI" DATABASETYPE="Oracle" DESCRIPTION="Staging degli ordini eseguiti">
        <TARGETFIELD NAME="COD_ISTITUTO"       DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_RIFERIMENTO"    DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_ORDINE"          DATATYPE="varchar2" PRECISION="30" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_DOSSIER"        DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_TITOLO"         DATATYPE="varchar2" PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_OPERAZIONE"     DATATYPE="varchar2" PRECISION="10" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="QTA_ORDINE"         DATATYPE="number"   PRECISION="18" SCALE="4" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_PREZZO"         DATATYPE="number"   PRECISION="18" SCALE="6" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_CONTO_ADDEBITO" DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NULL"    KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_SISTEMA_FONTE"  DATATYPE="varchar2" PRECISION="10" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_ELABORAZIONE"    DATATYPE="number"   PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </TARGET>

    <!-- ===================== MAPPING ===================== -->
    <MAPPING NAME="m_DI_CARICO_ORDINI" ISVALID="YES" DESCRIPTION="Carica il file degli ordini nello staging, convertendo date, quantita e prezzi">

        <TRANSFORMATION NAME="SQ_FF_ORDINI_FONTE_B" TYPE="Source Qualifier" REUSABLE="NO"/>

        <!-- Conversioni: date YYYYMMDD, numeri con la virgola decimale -->
        <TRANSFORMATION NAME="EXP_CONVERTI" TYPE="Expression" REUSABLE="NO">
            <TRANSFORMFIELD NAME="DATA_RIFERIMENTO" DATATYPE="string" PRECISION="8"  PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="QTA_ORDINE"       DATATYPE="string" PRECISION="20" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="IMP_PREZZO"       DATATYPE="string" PRECISION="20" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="O_DAT_RIFERIMENTO" DATATYPE="date/time" PRECISION="29" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DATE(DATA_RIFERIMENTO, 'YYYYMMDD')"/>
            <TRANSFORMFIELD NAME="O_QTA_ORDINE"      DATATYPE="decimal" PRECISION="18" SCALE="4" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL(REPLACESTR(0, QTA_ORDINE, ',', '.'), 4)"/>
            <TRANSFORMFIELD NAME="O_IMP_PREZZO"      DATATYPE="decimal" PRECISION="18" SCALE="6" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL(REPLACESTR(0, IMP_PREZZO, ',', '.'), 6)"/>
            <TRANSFORMFIELD NAME="O_COD_SISTEMA_FONTE" DATATYPE="string" PRECISION="10" PORTTYPE="OUTPUT"
                EXPRESSION="'FONTE_B'"/>
            <TRANSFORMFIELD NAME="O_ID_ELABORAZIONE" DATATYPE="decimal" PRECISION="12" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL($$ID_ELABORAZIONE)"/>
        </TRANSFORMATION>

        <!-- Scarta le righe di altre banche o di altri giorni, quelle senza quantita e le operazioni sconosciute -->
        <TRANSFORMATION NAME="FIL_RIGHE_VALIDE" TYPE="Filter" REUSABLE="NO">
            <TABLEATTRIBUTE NAME="Filter Condition" VALUE="COD_ISTITUTO = '$$COD_ISTITUTO' AND DATA_RIFERIMENTO = '$$DAT_RIFERIMENTO' AND NOT ISNULL(O_QTA_ORDINE) AND IN(COD_OPERAZIONE, 'ACQUISTO', 'VENDITA')"/>
        </TRANSFORMATION>

        <INSTANCE NAME="FF_ORDINI_FONTE_B"    TYPE="SOURCE"         TRANSFORMATION_NAME="FF_ORDINI_FONTE_B"/>
        <INSTANCE NAME="SQ_FF_ORDINI_FONTE_B" TYPE="TRANSFORMATION" TRANSFORMATION_NAME="SQ_FF_ORDINI_FONTE_B"/>
        <INSTANCE NAME="EXP_CONVERTI"         TYPE="TRANSFORMATION" TRANSFORMATION_NAME="EXP_CONVERTI"/>
        <INSTANCE NAME="FIL_RIGHE_VALIDE"     TYPE="TRANSFORMATION" TRANSFORMATION_NAME="FIL_RIGHE_VALIDE"/>
        <INSTANCE NAME="DI_STG_ORDINI"        TYPE="TARGET"         TRANSFORMATION_NAME="DI_STG_ORDINI"/>

        <!-- Collegamenti principali (elenco ridotto) -->
        <CONNECTOR FROMINSTANCE="SQ_FF_ORDINI_FONTE_B" FROMFIELD="DATA_RIFERIMENTO" TOINSTANCE="EXP_CONVERTI" TOFIELD="DATA_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="SQ_FF_ORDINI_FONTE_B" FROMFIELD="QTA_ORDINE"       TOINSTANCE="EXP_CONVERTI" TOFIELD="QTA_ORDINE"/>
        <CONNECTOR FROMINSTANCE="SQ_FF_ORDINI_FONTE_B" FROMFIELD="IMP_PREZZO"       TOINSTANCE="EXP_CONVERTI" TOFIELD="IMP_PREZZO"/>
        <CONNECTOR FROMINSTANCE="EXP_CONVERTI"     FROMFIELD="O_DAT_RIFERIMENTO"   TOINSTANCE="FIL_RIGHE_VALIDE" TOFIELD="O_DAT_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="EXP_CONVERTI"     FROMFIELD="O_QTA_ORDINE"        TOINSTANCE="FIL_RIGHE_VALIDE" TOFIELD="O_QTA_ORDINE"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_DAT_RIFERIMENTO"   TOINSTANCE="DI_STG_ORDINI"     TOFIELD="DAT_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_QTA_ORDINE"        TOINSTANCE="DI_STG_ORDINI"     TOFIELD="QTA_ORDINE"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_IMP_PREZZO"        TOINSTANCE="DI_STG_ORDINI"     TOFIELD="IMP_PREZZO"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_COD_SISTEMA_FONTE" TOINSTANCE="DI_STG_ORDINI"     TOFIELD="COD_SISTEMA_FONTE"/>
        <CONNECTOR FROMINSTANCE="FIL_RIGHE_VALIDE" FROMFIELD="O_ID_ELABORAZIONE"   TOINSTANCE="DI_STG_ORDINI"     TOFIELD="ID_ELABORAZIONE"/>

        <MAPPINGVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" PRECISION="5"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" PRECISION="8"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" PRECISION="12" ISPARAM="YES" DEFAULTVALUE=""/>
    </MAPPING>

    <!-- ===================== SESSIONE ===================== -->
    <SESSION NAME="s_m_DI_CARICO_ORDINI" MAPPINGNAME="m_DI_CARICO_ORDINI" REUSABLE="NO" DESCRIPTION="Carico del file degli ordini di una banca nello staging">
        <SESSIONEXTENSION SINSTANCENAME="SQ_FF_ORDINI_FONTE_B" TYPE="READER">
            <ATTRIBUTE NAME="Source filetype" VALUE="Direct"/>
            <ATTRIBUTE NAME="Source file name" VALUE="$InputFile_Ordini"/>
        </SESSIONEXTENSION>
        <SESSIONEXTENSION SINSTANCENAME="DI_STG_ORDINI" TYPE="WRITER">
            <CONNECTIONREFERENCE CONNECTIONNAME="CNX_DEMO_DWH" CONNECTIONTYPE="Relational"/>
            <ATTRIBUTE NAME="Truncate target table option" VALUE="NO"/>
        </SESSIONEXTENSION>
        <ATTRIBUTE NAME="Pushdown Optimization" VALUE="None"/>
    </SESSION>

    <!-- ===================== WORKFLOW ===================== -->
    <WORKFLOW NAME="wf_DI_CARICO_ORDINI" ISVALID="YES" SERVERNAME="IS_DEMO" DESCRIPTION="DEMO_INVESTIMENTI - carico degli ordini, lanciato da lancia_di_carico.sh">
        <TASK NAME="Start" TYPE="Start"/>
        <TASKINSTANCE NAME="Start"                TASKNAME="Start"                TASKTYPE="Start"/>
        <TASKINSTANCE NAME="s_m_DI_CARICO_ORDINI" TASKNAME="s_m_DI_CARICO_ORDINI" TASKTYPE="Session" FAIL_PARENT_IF_INSTANCE_FAILS="YES"/>
        <WORKFLOWLINK FROMTASK="Start" TOTASK="s_m_DI_CARICO_ORDINI" CONDITION=""/>
        <WORKFLOWVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Istituto in lavorazione, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Data di riferimento YYYYMMDD, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Elaborazione aperta dalla shell in DC_LOG_ELABORAZIONI"/>
    </WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
