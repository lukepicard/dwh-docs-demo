<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<!--
  Motore      : DEMO_INVESTIMENTI
  Workflow    : wf_DI_POSIZIONI
  Descrizione : Export PowerCenter SEMPLIFICATO e INVENTATO a scopo dimostrativo.
                Contiene solo i campi principali; non e' importabile in un
                repository reale.
-->
<POWERMART CREATION_DATE="09/30/2026 14:35:00" REPOSITORY_VERSION="189.99">
<REPOSITORY NAME="REP_DEMO" VERSION="189" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="DEMO_INVESTIMENTI" GROUP="" OWNER="demo_owner" SHARED="NOTSHARED" DESCRIPTION="Motore DEMO_INVESTIMENTI (dimostrativo)" PERMISSIONS="rwx---r--" UUID="00000000-0000-0000-0000-000000000003">

    <!-- ===================== SORGENTI ===================== -->
    <SOURCE NAME="DI_STG_ORDINI" DBDNAME="DEMO_DWH" DATABASETYPE="Oracle" OWNERNAME="DEMO_DWH" DESCRIPTION="Staging degli ordini eseguiti">
        <SOURCEFIELD NAME="COD_ISTITUTO"    DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="DAT_RIFERIMENTO" DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_DOSSIER"     DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_TITOLO"      DATATYPE="varchar2" PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_OPERAZIONE"  DATATYPE="varchar2" PRECISION="10" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="QTA_ORDINE"      DATATYPE="number"   PRECISION="18" SCALE="4" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </SOURCE>
    <SOURCE NAME="DI_FT_POSIZIONI" DBDNAME="DEMO_DWH" DATABASETYPE="Oracle" OWNERNAME="DEMO_DWH" DESCRIPTION="Posizioni per dossier e titolo a fine giornata">
        <SOURCEFIELD NAME="COD_ISTITUTO"         DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="DAT_RIFERIMENTO"      DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_DOSSIER"          DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="COD_TITOLO"           DATATYPE="varchar2" PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="QTA_FINALE"           DATATYPE="number"   PRECISION="18" SCALE="4" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="IMP_PREZZO"           DATATYPE="number"   PRECISION="18" SCALE="6" NULLABLE="NULL"    KEYTYPE="NOT A KEY"/>
        <SOURCEFIELD NAME="FLG_PREZZO_RIPORTATO" DATATYPE="char"     PRECISION="1"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </SOURCE>

    <!-- ===================== TARGET ===================== -->
    <TARGET NAME="DI_FT_POSIZIONI" DATABASETYPE="Oracle" DESCRIPTION="Posizioni per dossier e titolo a fine giornata">
        <TARGETFIELD NAME="COD_ISTITUTO"         DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_RIFERIMENTO"      DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_DOSSIER"          DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_TITOLO"           DATATYPE="varchar2" PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="QTA_INIZIALE"         DATATYPE="number"   PRECISION="18" SCALE="4" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="QTA_ACQUISTI"         DATATYPE="number"   PRECISION="18" SCALE="4" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="QTA_VENDITE"          DATATYPE="number"   PRECISION="18" SCALE="4" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="QTA_FINALE"           DATATYPE="number"   PRECISION="18" SCALE="4" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_PREZZO"           DATATYPE="number"   PRECISION="18" SCALE="6" NULLABLE="NULL"    KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="FLG_PREZZO_RIPORTATO" DATATYPE="char"     PRECISION="1"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_ELABORAZIONE"      DATATYPE="number"   PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </TARGET>
    <TARGET NAME="DI_FT_CONTROVALORI_MENSILI" DATABASETYPE="Oracle" DESCRIPTION="Controvalore dei titoli per dossier e mese">
        <TARGETFIELD NAME="COD_ISTITUTO"                DATATYPE="varchar2" PRECISION="5"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="DAT_RIFERIMENTO"             DATATYPE="date"     PRECISION="19" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="COD_DOSSIER"                 DATATYPE="varchar2" PRECISION="20" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="NUM_TITOLI"                  DATATYPE="number"   PRECISION="9"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="NUM_TITOLI_PREZZO_RIPORTATO" DATATYPE="number"   PRECISION="9"  SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="IMP_CONTROVALORE"            DATATYPE="number"   PRECISION="18" SCALE="2" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
        <TARGETFIELD NAME="ID_ELABORAZIONE"             DATATYPE="number"   PRECISION="12" SCALE="0" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY"/>
    </TARGET>

    <!-- =============== MAPPING 1: posizioni di fine giornata =============== -->
    <MAPPING NAME="m_DI_POSIZIONI" ISVALID="YES" DESCRIPTION="Calcola la posizione di fine giornata per dossier e titolo, con il prezzo di chiusura">

        <!-- Ordini del giorno raggruppati per dossier e titolo, uniti alla posizione dell'ultimo giorno
             precedente (solo se diversa da zero) e al prezzo del giorno. Se il prezzo del giorno manca
             si usa quello della posizione precedente e la riga e' marcata. -->
        <TRANSFORMATION NAME="SQ_DI_POSIZIONI" TYPE="Source Qualifier" REUSABLE="NO">
            <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT COALESCE(o.COD_DOSSIER, p.COD_DOSSIER) AS COD_DOSSIER, COALESCE(o.COD_TITOLO, p.COD_TITOLO) AS COD_TITOLO, NVL(p.QTA_FINALE, 0) AS QTA_INIZIALE, NVL(o.QTA_ACQUISTI, 0) AS QTA_ACQUISTI, NVL(o.QTA_VENDITE, 0) AS QTA_VENDITE, NVL(z.IMP_PREZZO, p.IMP_PREZZO) AS IMP_PREZZO, CASE WHEN z.IMP_PREZZO IS NULL THEN 'S' ELSE 'N' END AS FLG_PREZZO_RIPORTATO FROM (SELECT COD_DOSSIER, COD_TITOLO, SUM(CASE WHEN COD_OPERAZIONE = 'ACQUISTO' THEN QTA_ORDINE ELSE 0 END) AS QTA_ACQUISTI, SUM(CASE WHEN COD_OPERAZIONE = 'VENDITA' THEN QTA_ORDINE ELSE 0 END) AS QTA_VENDITE FROM DEMO_DWH.DI_STG_ORDINI WHERE COD_ISTITUTO = '$$COD_ISTITUTO' AND DAT_RIFERIMENTO = TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD') GROUP BY COD_DOSSIER, COD_TITOLO) o FULL OUTER JOIN (SELECT COD_DOSSIER, COD_TITOLO, QTA_FINALE, IMP_PREZZO FROM DEMO_DWH.DI_FT_POSIZIONI WHERE COD_ISTITUTO = '$$COD_ISTITUTO' AND QTA_FINALE &lt;&gt; 0 AND DAT_RIFERIMENTO = (SELECT MAX(DAT_RIFERIMENTO) FROM DEMO_DWH.DI_FT_POSIZIONI WHERE COD_ISTITUTO = '$$COD_ISTITUTO' AND DAT_RIFERIMENTO &lt; TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD'))) p ON p.COD_DOSSIER = o.COD_DOSSIER AND p.COD_TITOLO = o.COD_TITOLO LEFT JOIN DEMO_DWH.DI_STG_PREZZI z ON z.COD_TITOLO = COALESCE(o.COD_TITOLO, p.COD_TITOLO) AND z.COD_ISTITUTO = '$$COD_ISTITUTO' AND z.DAT_RIFERIMENTO = TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD')"/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="EXP_POSIZIONE" TYPE="Expression" REUSABLE="NO">
            <TRANSFORMFIELD NAME="QTA_INIZIALE" DATATYPE="decimal" PRECISION="18" SCALE="4" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="QTA_ACQUISTI" DATATYPE="decimal" PRECISION="18" SCALE="4" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="QTA_VENDITE"  DATATYPE="decimal" PRECISION="18" SCALE="4" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="O_QTA_FINALE" DATATYPE="decimal" PRECISION="18" SCALE="4" PORTTYPE="OUTPUT"
                EXPRESSION="QTA_INIZIALE + QTA_ACQUISTI - QTA_VENDITE"/>
            <TRANSFORMFIELD NAME="O_COD_ISTITUTO" DATATYPE="string" PRECISION="5" PORTTYPE="OUTPUT"
                EXPRESSION="'$$COD_ISTITUTO'"/>
            <TRANSFORMFIELD NAME="O_DAT_RIFERIMENTO" DATATYPE="date/time" PRECISION="29" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DATE('$$DAT_RIFERIMENTO', 'YYYYMMDD')"/>
            <TRANSFORMFIELD NAME="O_ID_ELABORAZIONE" DATATYPE="decimal" PRECISION="12" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL($$ID_ELABORAZIONE)"/>
        </TRANSFORMATION>

        <!-- Una posizione che si azzera nella giornata resta in tabella per quel giorno, poi non si riporta piu -->
        <INSTANCE NAME="DI_STG_ORDINI"    TYPE="SOURCE"         TRANSFORMATION_NAME="DI_STG_ORDINI"/>
        <INSTANCE NAME="DI_FT_POSIZIONI_S" TYPE="SOURCE"        TRANSFORMATION_NAME="DI_FT_POSIZIONI"/>
        <INSTANCE NAME="SQ_DI_POSIZIONI"  TYPE="TRANSFORMATION" TRANSFORMATION_NAME="SQ_DI_POSIZIONI"/>
        <INSTANCE NAME="EXP_POSIZIONE"    TYPE="TRANSFORMATION" TRANSFORMATION_NAME="EXP_POSIZIONE"/>
        <INSTANCE NAME="DI_FT_POSIZIONI"  TYPE="TARGET"         TRANSFORMATION_NAME="DI_FT_POSIZIONI"/>

        <!-- Collegamenti principali (elenco ridotto) -->
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="QTA_INIZIALE" TOINSTANCE="EXP_POSIZIONE" TOFIELD="QTA_INIZIALE"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="QTA_ACQUISTI" TOINSTANCE="EXP_POSIZIONE" TOFIELD="QTA_ACQUISTI"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="QTA_VENDITE"  TOINSTANCE="EXP_POSIZIONE" TOFIELD="QTA_VENDITE"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="COD_DOSSIER"  TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="COD_DOSSIER"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="COD_TITOLO"   TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="COD_TITOLO"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="QTA_INIZIALE" TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="QTA_INIZIALE"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="QTA_ACQUISTI" TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="QTA_ACQUISTI"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="QTA_VENDITE"  TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="QTA_VENDITE"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="IMP_PREZZO"   TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="IMP_PREZZO"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_POSIZIONI" FROMFIELD="FLG_PREZZO_RIPORTATO" TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="FLG_PREZZO_RIPORTATO"/>
        <CONNECTOR FROMINSTANCE="EXP_POSIZIONE" FROMFIELD="O_QTA_FINALE"      TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="QTA_FINALE"/>
        <CONNECTOR FROMINSTANCE="EXP_POSIZIONE" FROMFIELD="O_COD_ISTITUTO"    TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="COD_ISTITUTO"/>
        <CONNECTOR FROMINSTANCE="EXP_POSIZIONE" FROMFIELD="O_DAT_RIFERIMENTO" TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="DAT_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="EXP_POSIZIONE" FROMFIELD="O_ID_ELABORAZIONE" TOINSTANCE="DI_FT_POSIZIONI" TOFIELD="ID_ELABORAZIONE"/>

        <MAPPINGVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" PRECISION="5"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" PRECISION="8"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" PRECISION="12" ISPARAM="YES" DEFAULTVALUE=""/>
    </MAPPING>

    <!-- =============== MAPPING 2: controvalori di fine mese =============== -->
    <MAPPING NAME="m_DI_CONTROVALORI" ISVALID="YES" DESCRIPTION="Calcola il controvalore dei titoli di ogni dossier all ultimo giorno del mese">

        <TRANSFORMATION NAME="SQ_DI_FT_POSIZIONI" TYPE="Source Qualifier" REUSABLE="NO">
            <TABLEATTRIBUTE NAME="Source Filter" VALUE="DI_FT_POSIZIONI.COD_ISTITUTO = '$$COD_ISTITUTO' AND DI_FT_POSIZIONI.DAT_RIFERIMENTO = TO_DATE('$$DAT_RIFERIMENTO','YYYYMMDD') AND DI_FT_POSIZIONI.QTA_FINALE &lt;&gt; 0"/>
        </TRANSFORMATION>

        <!-- Il tipo del titolo decide come si calcola il controvalore -->
        <TRANSFORMATION NAME="LKP_DI_DIM_TITOLO" TYPE="Lookup Procedure" REUSABLE="NO">
            <TRANSFORMFIELD NAME="IN_COD_TITOLO" DATATYPE="string" PRECISION="12" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="COD_TITOLO"    DATATYPE="string" PRECISION="12" PORTTYPE="LOOKUP"/>
            <TRANSFORMFIELD NAME="COD_TIPO"      DATATYPE="string" PRECISION="15" PORTTYPE="LOOKUP/OUTPUT"/>
            <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DEMO_DWH.DI_DIM_TITOLO"/>
            <TABLEATTRIBUTE NAME="Lookup Sql Override" VALUE="SELECT COD_TITOLO, COD_TIPO FROM DEMO_DWH.DI_DIM_TITOLO"/>
            <TABLEATTRIBUTE NAME="Lookup condition" VALUE="COD_TITOLO = IN_COD_TITOLO"/>
        </TRANSFORMATION>

        <!-- Obbligazioni: prezzo in percentuale del nominale, si divide per 100. Titolo mai quotato: controvalore zero -->
        <TRANSFORMATION NAME="EXP_CONTROVALORE" TYPE="Expression" REUSABLE="NO">
            <TRANSFORMFIELD NAME="QTA_FINALE" DATATYPE="decimal" PRECISION="18" SCALE="4" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="IMP_PREZZO" DATATYPE="decimal" PRECISION="18" SCALE="6" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="COD_TIPO"   DATATYPE="string"  PRECISION="15" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="O_IMP_CONTROVALORE" DATATYPE="decimal" PRECISION="18" SCALE="2" PORTTYPE="OUTPUT"
                EXPRESSION="IIF(ISNULL(IMP_PREZZO), 0, IIF(COD_TIPO = 'OBBLIGAZIONE', ROUND(QTA_FINALE * IMP_PREZZO / 100, 2), ROUND(QTA_FINALE * IMP_PREZZO, 2)))"/>
            <TRANSFORMFIELD NAME="O_FLG_RIPORTATO" DATATYPE="decimal" PRECISION="1" PORTTYPE="OUTPUT"
                EXPRESSION="IIF(FLG_PREZZO_RIPORTATO = 'S', 1, 0)"/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="AGG_DOSSIER" TYPE="Aggregator" REUSABLE="NO">
            <TRANSFORMFIELD NAME="COD_DOSSIER"       DATATYPE="string"  PRECISION="20" PORTTYPE="INPUT/OUTPUT" EXPRESSIONTYPE="GROUPBY"/>
            <TRANSFORMFIELD NAME="O_IMP_CONTROVALORE" DATATYPE="decimal" PRECISION="18" SCALE="2" PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="O_FLG_RIPORTATO"   DATATYPE="decimal" PRECISION="1"  PORTTYPE="INPUT"/>
            <TRANSFORMFIELD NAME="A_NUM_TITOLI"      DATATYPE="decimal" PRECISION="9"  PORTTYPE="OUTPUT" EXPRESSION="COUNT(O_IMP_CONTROVALORE)"/>
            <TRANSFORMFIELD NAME="A_NUM_RIPORTATI"   DATATYPE="decimal" PRECISION="9"  PORTTYPE="OUTPUT" EXPRESSION="SUM(O_FLG_RIPORTATO)"/>
            <TRANSFORMFIELD NAME="A_IMP_CONTROVALORE" DATATYPE="decimal" PRECISION="18" SCALE="2" PORTTYPE="OUTPUT" EXPRESSION="SUM(O_IMP_CONTROVALORE)"/>
        </TRANSFORMATION>

        <TRANSFORMATION NAME="EXP_TESTATA" TYPE="Expression" REUSABLE="NO">
            <TRANSFORMFIELD NAME="O_COD_ISTITUTO" DATATYPE="string" PRECISION="5" PORTTYPE="OUTPUT"
                EXPRESSION="'$$COD_ISTITUTO'"/>
            <TRANSFORMFIELD NAME="O_DAT_RIFERIMENTO" DATATYPE="date/time" PRECISION="29" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DATE('$$DAT_RIFERIMENTO', 'YYYYMMDD')"/>
            <TRANSFORMFIELD NAME="O_ID_ELABORAZIONE" DATATYPE="decimal" PRECISION="12" PORTTYPE="OUTPUT"
                EXPRESSION="TO_DECIMAL($$ID_ELABORAZIONE)"/>
        </TRANSFORMATION>

        <INSTANCE NAME="DI_FT_POSIZIONI_C"          TYPE="SOURCE"         TRANSFORMATION_NAME="DI_FT_POSIZIONI"/>
        <INSTANCE NAME="SQ_DI_FT_POSIZIONI"         TYPE="TRANSFORMATION" TRANSFORMATION_NAME="SQ_DI_FT_POSIZIONI"/>
        <INSTANCE NAME="LKP_DI_DIM_TITOLO"          TYPE="TRANSFORMATION" TRANSFORMATION_NAME="LKP_DI_DIM_TITOLO"/>
        <INSTANCE NAME="EXP_CONTROVALORE"           TYPE="TRANSFORMATION" TRANSFORMATION_NAME="EXP_CONTROVALORE"/>
        <INSTANCE NAME="AGG_DOSSIER"                TYPE="TRANSFORMATION" TRANSFORMATION_NAME="AGG_DOSSIER"/>
        <INSTANCE NAME="EXP_TESTATA"                TYPE="TRANSFORMATION" TRANSFORMATION_NAME="EXP_TESTATA"/>
        <INSTANCE NAME="DI_FT_CONTROVALORI_MENSILI" TYPE="TARGET"         TRANSFORMATION_NAME="DI_FT_CONTROVALORI_MENSILI"/>

        <!-- Collegamenti principali (elenco ridotto) -->
        <CONNECTOR FROMINSTANCE="SQ_DI_FT_POSIZIONI" FROMFIELD="COD_TITOLO" TOINSTANCE="LKP_DI_DIM_TITOLO" TOFIELD="IN_COD_TITOLO"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_FT_POSIZIONI" FROMFIELD="QTA_FINALE" TOINSTANCE="EXP_CONTROVALORE" TOFIELD="QTA_FINALE"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_FT_POSIZIONI" FROMFIELD="IMP_PREZZO" TOINSTANCE="EXP_CONTROVALORE" TOFIELD="IMP_PREZZO"/>
        <CONNECTOR FROMINSTANCE="LKP_DI_DIM_TITOLO"  FROMFIELD="COD_TIPO"   TOINSTANCE="EXP_CONTROVALORE" TOFIELD="COD_TIPO"/>
        <CONNECTOR FROMINSTANCE="SQ_DI_FT_POSIZIONI" FROMFIELD="COD_DOSSIER" TOINSTANCE="AGG_DOSSIER" TOFIELD="COD_DOSSIER"/>
        <CONNECTOR FROMINSTANCE="EXP_CONTROVALORE" FROMFIELD="O_IMP_CONTROVALORE" TOINSTANCE="AGG_DOSSIER" TOFIELD="O_IMP_CONTROVALORE"/>
        <CONNECTOR FROMINSTANCE="EXP_CONTROVALORE" FROMFIELD="O_FLG_RIPORTATO"    TOINSTANCE="AGG_DOSSIER" TOFIELD="O_FLG_RIPORTATO"/>
        <CONNECTOR FROMINSTANCE="AGG_DOSSIER" FROMFIELD="COD_DOSSIER"       TOINSTANCE="DI_FT_CONTROVALORI_MENSILI" TOFIELD="COD_DOSSIER"/>
        <CONNECTOR FROMINSTANCE="AGG_DOSSIER" FROMFIELD="A_NUM_TITOLI"      TOINSTANCE="DI_FT_CONTROVALORI_MENSILI" TOFIELD="NUM_TITOLI"/>
        <CONNECTOR FROMINSTANCE="AGG_DOSSIER" FROMFIELD="A_NUM_RIPORTATI"   TOINSTANCE="DI_FT_CONTROVALORI_MENSILI" TOFIELD="NUM_TITOLI_PREZZO_RIPORTATO"/>
        <CONNECTOR FROMINSTANCE="AGG_DOSSIER" FROMFIELD="A_IMP_CONTROVALORE" TOINSTANCE="DI_FT_CONTROVALORI_MENSILI" TOFIELD="IMP_CONTROVALORE"/>
        <CONNECTOR FROMINSTANCE="EXP_TESTATA" FROMFIELD="O_COD_ISTITUTO"    TOINSTANCE="DI_FT_CONTROVALORI_MENSILI" TOFIELD="COD_ISTITUTO"/>
        <CONNECTOR FROMINSTANCE="EXP_TESTATA" FROMFIELD="O_DAT_RIFERIMENTO" TOINSTANCE="DI_FT_CONTROVALORI_MENSILI" TOFIELD="DAT_RIFERIMENTO"/>
        <CONNECTOR FROMINSTANCE="EXP_TESTATA" FROMFIELD="O_ID_ELABORAZIONE" TOINSTANCE="DI_FT_CONTROVALORI_MENSILI" TOFIELD="ID_ELABORAZIONE"/>

        <MAPPINGVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" PRECISION="5"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" PRECISION="8"  ISPARAM="YES" DEFAULTVALUE=""/>
        <MAPPINGVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" PRECISION="12" ISPARAM="YES" DEFAULTVALUE=""/>
    </MAPPING>

    <!-- ===================== SESSIONI ===================== -->
    <SESSION NAME="s_m_DI_POSIZIONI" MAPPINGNAME="m_DI_POSIZIONI" REUSABLE="NO" DESCRIPTION="Posizioni di fine giornata per istituto">
        <SESSIONEXTENSION SINSTANCENAME="DI_FT_POSIZIONI" TYPE="WRITER">
            <CONNECTIONREFERENCE CONNECTIONNAME="CNX_DEMO_DWH" CONNECTIONTYPE="Relational"/>
            <ATTRIBUTE NAME="Truncate target table option" VALUE="NO"/>
        </SESSIONEXTENSION>
        <ATTRIBUTE NAME="Pushdown Optimization" VALUE="None"/>
    </SESSION>
    <SESSION NAME="s_m_DI_CONTROVALORI" MAPPINGNAME="m_DI_CONTROVALORI" REUSABLE="NO" DESCRIPTION="Controvalori dei dossier, solo a fine mese">
        <SESSIONEXTENSION SINSTANCENAME="DI_FT_CONTROVALORI_MENSILI" TYPE="WRITER">
            <CONNECTIONREFERENCE CONNECTIONNAME="CNX_DEMO_DWH" CONNECTIONTYPE="Relational"/>
            <ATTRIBUTE NAME="Truncate target table option" VALUE="NO"/>
        </SESSIONEXTENSION>
        <ATTRIBUTE NAME="Pushdown Optimization" VALUE="None"/>
    </SESSION>

    <!-- ===================== WORKFLOW ===================== -->
    <WORKFLOW NAME="wf_DI_POSIZIONI" ISVALID="YES" SERVERNAME="IS_DEMO" DESCRIPTION="DEMO_INVESTIMENTI - posizioni giornaliere e controvalori di fine mese, lanciato da lancia_di_posizioni.sh">
        <TASK NAME="Start" TYPE="Start"/>
        <TASKINSTANCE NAME="Start"                TASKNAME="Start"                TASKTYPE="Start"/>
        <TASKINSTANCE NAME="s_m_DI_POSIZIONI"     TASKNAME="s_m_DI_POSIZIONI"     TASKTYPE="Session" FAIL_PARENT_IF_INSTANCE_FAILS="YES"/>
        <TASKINSTANCE NAME="s_m_DI_CONTROVALORI"  TASKNAME="s_m_DI_CONTROVALORI"  TASKTYPE="Session" FAIL_PARENT_IF_INSTANCE_FAILS="YES"/>
        <WORKFLOWLINK FROMTASK="Start"            TOTASK="s_m_DI_POSIZIONI"    CONDITION=""/>
        <!-- I controvalori partono solo se la data e' l'ultimo giorno del mese -->
        <WORKFLOWLINK FROMTASK="s_m_DI_POSIZIONI" TOTASK="s_m_DI_CONTROVALORI" CONDITION="$s_m_DI_POSIZIONI.Status = SUCCEEDED AND $$FLG_FINE_MESE = 'S'"/>
        <WORKFLOWVARIABLE NAME="$$COD_ISTITUTO"    DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Istituto in lavorazione, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$DAT_RIFERIMENTO" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Data di riferimento YYYYMMDD, da file parametri"/>
        <WORKFLOWVARIABLE NAME="$$ID_ELABORAZIONE" DATATYPE="string" ISPERSISTENT="NO" DESCRIPTION="Elaborazione aperta dalla shell in DC_LOG_ELABORAZIONI"/>
