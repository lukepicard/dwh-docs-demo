<?xml version="1.0" encoding="UTF-8"?>
<POWERMART>
<REPOSITORY NAME="REP">
<FOLDER NAME="PROVA">
    <SOURCE NAME="T_A" DATABASETYPE="Oracle">
        <SOURCEFIELD NAME="ID"/>
        <SOURCEFIELD NAME="IMPORTO"/>
    </SOURCE>
    <TARGET NAME="T_C" DATABASETYPE="Oracle">
        <TARGETFIELD NAME="ID"/>
        <TARGETFIELD NAME="IMPORTO"/>
    </TARGET>
    <MAPPING NAME="m_X">
        <TRANSFORMATION NAME="SQ_T_A" TYPE="Source Qualifier">
            <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT A.ID, A.IMPORTO FROM PROVA.T_A A WHERE A.IMPORTO &gt; 0"/>
        </TRANSFORMATION>
        <TRANSFORMATION NAME="LKP_T_B" TYPE="Lookup Procedure">
            <TRANSFORMFIELD NAME="ID" PORTTYPE="LOOKUP"/>
            <TRANSFORMFIELD NAME="STATO" PORTTYPE="LOOKUP/OUTPUT"/>
            <TABLEATTRIBUTE NAME="Lookup table name" VALUE="PROVA.T_B"/>
            <TABLEATTRIBUTE NAME="Lookup Sql Override" VALUE="SELECT ID, STATO FROM PROVA.T_B WHERE STATO = 'APERTO'"/>
        </TRANSFORMATION>
    </MAPPING>
    <SESSION NAME="s_m_X" MAPPINGNAME="m_X">
        <SESSIONEXTENSION SINSTANCENAME="T_C" TYPE="WRITER">
            <ATTRIBUTE NAME="Pre SQL" VALUE="DELETE FROM PROVA.T_C WHERE ID &lt; 0"/>
            <ATTRIBUTE NAME="Post SQL" VALUE="UPDATE PROVA.T_B SET STATO = 'ELABORATO'"/>
        </SESSIONEXTENSION>
    </SESSION>
    <WORKFLOW NAME="wf_X" DESCRIPTION="Workflow di prova"/>
</FOLDER>
</REPOSITORY>
</POWERMART>
